# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=1
SHUTDOWN_TIMEOUT_MS=10000

# Base de datos
DB_PORT=5432
DATABASE_URL=postgres://follow:follow@localhost:5432/follow
DATABASE_TEST_URL=postgres://follow:follow@localhost:5432/follow_test
DB_POOL_MAX=20

# Seguridad
JWT_SECRET=change-me-in-local-development-with-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_MIN_LENGTH=6
PASSWORD_MAX_LENGTH=128
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=5
IMPORT_RATE_LIMIT_MAX=5
INTERNAL_METRICS_TOKEN=local-metrics-token

# Importación CSV
IMPORT_MAX_FILE_BYTES=10485760
IMPORT_MAX_ROWS=20000
IMPORT_LEASE_SECONDS=120
IMPORT_HEARTBEAT_SECONDS=30
IMPORT_MAX_ATTEMPTS=3
IMPORT_RETENTION_DAYS=90
IMPORT_STORAGE_DIR=storage/imports
# Solo para medición: procesa el CSV en el hilo principal con readFileSync.
IMPORT_NAIVE=false

# Idempotencia
IDEMPOTENCY_TTL_HOURS=24

# Workers
RUN_IMPORT_WORKER=true
RUN_NOTIFICATION_WORKER=true
