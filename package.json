{
  "name": "follow-up-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Follow App - API REST de gestión educativa (Node.js + Express + PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/servidor.js",
    "db:migrate": "node-pg-migrate up -m src/infra/db/migrations -j sql --envPath .env",
    "db:rollback": "node-pg-migrate down -m src/infra/db/migrations -j sql --envPath .env",
    "db:seed": "tsx src/infra/db/seeds/seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "setup": "tsx scripts/setup.ts",
    "test": "vitest run",
    "test:domain": "vitest run tests/domain",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:concurrency": "vitest run tests/concurrency",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "heavy:generate-csv": "tsx scripts/heavy/generate-csv.ts",
    "heavy:prepare-courses": "tsx scripts/heavy/prepare-courses.ts",
    "heavy:import:naive": "tsx scripts/heavy/import-naive.ts",
    "heavy:import:final": "tsx scripts/heavy/import-final.ts",
    "load:health": "tsx scripts/load/health.ts",
    "load:import": "tsx scripts/load/import.ts"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "autocannon": "^8.0.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^2.1.8"
  }
}
